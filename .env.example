# SafeLink Platform Configuration Template

# General
ENVIRONMENT=development
APP_NAME=SafeLink
APP_ENV=local
DEBUG=True
SECRET_KEY=replace-with-a-cryptographically-secure-random-64-char-string-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Brand / Design Defaults
BRAND_NAME=SafeLink
MINIMUM_REGISTRATION_AGE=18
DEFAULT_SEARCH_RADIUS_METERS=1000
EXPANDED_SEARCH_RADIUS_METERS=2000
MAX_SEARCH_RADIUS_METERS=3000
VOLUNTEER_LOCATION_STALE_MINUTES=5
INCIDENT_EXPIRATION_HOURS=6

# URLs
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
EMERGENCY_TRACKING_BASE_URL=http://localhost:3000/t

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://safelink:safelink_secret@localhost:5432/safelink_db
DATABASE_URL_SYNC=postgresql://safelink:safelink_secret@localhost:5432/safelink_db
POSTGRES_USER=safelink
POSTGRES_PASSWORD=safelink_secret
POSTGRES_DB=safelink_db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3 / MinIO)
STORAGE_PROVIDER=local  # Options: local, minio, s3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=safelink-verification-private
S3_REGION=us-east-1

# Identity & Verification Providers
VERIFICATION_PROVIDER=mock  # Options: mock, digilocker, authorized_kyc
LIVENESS_PROVIDER=mock      # Options: mock, mediapipe, authorized_vendor

# Notifications (SMS, WhatsApp, Email, FCM)
SMS_PROVIDER=mock           # Options: mock, msg91, twilio
SMS_API_KEY=
SMS_SENDER_ID=SAFLNK
SMS_DLT_TE_ID=

WHATSAPP_PROVIDER=mock      # Options: mock, meta_official, twilio
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

EMAIL_PROVIDER=mock         # Options: mock, smtp, resend
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=alerts@safelink.local

FCM_CREDENTIALS_JSON=
FCM_ENABLED=False

# Rate Limiting & Security
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
RATE_LIMIT_PER_MINUTE=60
