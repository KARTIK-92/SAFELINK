# ==============================================================================
# SafeLink Environment Configuration Template
# ==============================================================================
# NOTE: This file contains ONLY template placeholders and documentation.
# NEVER commit real secret keys, private passwords, or production API tokens
# into Git or public repositories.
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development        # production, development, test
DEBUG=False
APP_NAME=SafeLink
BRAND_NAME=SafeLink

# --- Cryptographic Security ---
# Generate a cryptographically secure 64-char key: `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=replace-with-a-cryptographically-secure-random-64-char-string-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Domain & URL Routing ---
# Set to your live production domains (e.g. Vercel & Render)
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
EMERGENCY_TRACKING_BASE_URL=http://localhost:3000/t

# --- Database (Managed PostgreSQL with PostGIS) ---
# FREE TIER: Supabase provides a free PostgreSQL database with PostGIS pre-enabled.
# Example: postgresql+asyncpg://postgres.[REF]:[PASS]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://safelink:safelink_secret@localhost:5432/safelink_db
DATABASE_URL_SYNC=postgresql://safelink:safelink_secret@localhost:5432/safelink_db

# --- Redis (Ephemeral Caching & Session Engine) ---
# FREE TIER: Upstash provides 10,000 commands/day free serverless Redis.
# Example: rediss://default:[TOKEN]@[HOST].upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# --- Object Storage (KYC Verification Documents) ---
# FREE TIER: Supabase Storage or Cloudflare R2 (10 GB free S3-compatible storage)
STORAGE_PROVIDER=local        # local, s3, minio
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=safelink-verification-private
S3_REGION=us-east-1

# --- Notifications (100% Free Tiers Supported) ---
# 1. Email: Resend (Free Tier: 3,000 emails/month free forever)
RESEND_API_KEY=
EMAIL_FROM=SafeLink Emergency <alerts@safelink.org>

# 2. Email Alternative: Standard SMTP (Brevo 300/day free or Gmail App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# 3. SMS: Twilio or Fast2SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FAST2SMS_API_KEY=

# 4. Push Notifications: Firebase Cloud Messaging (FCM - 100% Free Forever)
FCM_SERVER_KEY=
FCM_SERVICE_ACCOUNT_JSON=

# --- Identity & KYC Verification ---
# Government ID: DigiLocker Sandbox API (Free official government gateway)
VERIFICATION_PROVIDER=digilocker  # digilocker, kyc_docs
LIVENESS_PROVIDER=biometric       # biometric
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=

# --- Emergency Incident Parameters ---
MINIMUM_REGISTRATION_AGE=18
DEFAULT_SEARCH_RADIUS_METERS=1000
EXPANDED_SEARCH_RADIUS_METERS=2000
MAX_SEARCH_RADIUS_METERS=3000
MAX_VOLUNTEER_NOTIFICATIONS_INITIAL=15
MAX_ASSIGNED_RESPONDERS=3
VOLUNTEER_LOCATION_STALE_MINUTES=5
INCIDENT_EXPIRATION_HOURS=6

# --- Rate Limiting & OTP Security ---
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_PEPPER=safelink-otp-pepper-secret-random-salt
RATE_LIMIT_PER_MINUTE=60
