# SafeLink API Service Environment Variables
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=replace-with-a-cryptographically-secure-random-64-char-string-in-prod
ALGORITHM=HS256

# Database (Supabase PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres
DATABASE_URL_SYNC=postgresql://postgres:YOUR_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres

# Redis (Upstash Serverless Redis)
REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_UPSTASH_ENDPOINT.upstash.io:6379

# Domains
FRONTEND_URL=https://your-safelink-app.vercel.app
API_BASE_URL=https://your-safelink-api.onrender.com
EMERGENCY_TRACKING_BASE_URL=https://your-safelink-app.vercel.app/t

# Free Email Service (Resend)
RESEND_API_KEY=
EMAIL_FROM=SafeLink Emergency <alerts@safelink.org>

# Free Push Notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY=
